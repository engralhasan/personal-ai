# ==============================================================================
# J.A.R.V.I.S. Desktop Assistant - Environment Configuration
# ==============================================================================

# --- LLM Provider Configuration ---
# Choose from: "ollama", "gemini", "openai"
LLM_PROVIDER=gemini

# Model name:
# For Gemini: "gemini/gemini-2.0-flash" or "gemini/gemini-1.5-pro"
# For Ollama: "ollama/llama3.2" or "ollama/mistral" or "ollama/qwen2.5:7b"
# For OpenAI: "gpt-4o" or "gpt-4o-mini"
LLM_MODEL=gemini/gemini-2.0-flash

# API Keys (fill the one matching your LLM_PROVIDER)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_API_BASE=http://localhost:11434

# --- Wake Word & Audio Engine ---
WAKE_WORD=hey jarvis
# Wake word sensitivity (0.0 to 1.0)
WAKE_WORD_SENSITIVITY=0.6
# Optional Picovoice Porcupine Access Key (if using pvporcupine)
PICOVOICE_ACCESS_KEY=

# --- Speech-to-Text (STT) Settings ---
# faster-whisper model sizes: "tiny", "base", "small", "medium", "large-v3"
# "base" is recommended for real-time CPU transcription; "small" or "medium" with GPU
STT_MODEL_SIZE=base
# Device: "cpu" or "cuda"
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# Primary spoken language: "auto", "en" (English), "bn" (Bengali)
STT_LANGUAGE=auto

# --- Text-to-Speech (TTS) Settings ---
# Edge-TTS voice options:
# English: "en-US-ChristopherNeural" (Deep/Natural Jarvis), "en-US-GuyNeural", "en-US-JennyNeural"
# Bengali: "bn-BD-PradeepNeural" (Male), "bn-BD-NabanitaNeural" (Female)
TTS_VOICE_EN=en-US-ChristopherNeural
TTS_VOICE_BN=bn-BD-PradeepNeural
# Speech rate adjustment: "+0%", "+10%", "-5%"
TTS_RATE=+5%
# Pitch adjustment: "+0Hz", "-5Hz"
TTS_PITCH=+0Hz
# Fallback to offline engine when internet is disconnected (true/false)
TTS_FALLBACK_OFFLINE=true

# --- Security & Human-in-the-Loop Confirmation Gate ---
# Require explicit user confirmation before executing high-risk destructive actions
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE=true
CONFIRMATION_TIMEOUT_SECONDS=15

# --- Storage & Memory Paths ---
APP_DATA_DIR=./data
CHROMA_PERSIST_DIR=./data/chroma
SQLITE_DB_PATH=./data/jarvis_memory.db
SCREENSHOTS_DIR=./data/screenshots
LOG_LEVEL=INFO
